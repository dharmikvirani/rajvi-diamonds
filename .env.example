# Supabase Database & Auth (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Cloudinary Image Management (Get from Cloudinary Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Standalone Admin Access Key (fallback when Supabase Auth is initializing)
ADMIN_SECRET_KEY=RajviLuxurySecure2024!
